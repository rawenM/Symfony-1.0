<h1>List of Authors</h1>

<table border="1" cellpadding="8">
    <thead>
        <tr>
            <th>ID</th>
            <th>Picture</th>
            <th>Username</th>
            <th>Email</th>
            <th>Number of Books</th>
        </tr>
    </thead>
    <tbody>
        {% for author in authorDB %}
            <tr>
                <td>{{ author.id }}</td>
                <td><img src="{{ author.picture }}" alt="{{ author.username }}" width="60"></td>
                <td>{{ author.username }}</td>
                <td>{{ author.email }}</td>
                <td>{{ author.nbBooks }}</td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">No authors found in the database.</td>
            </tr>
        {% endfor %}
    </tbody>
</table>
